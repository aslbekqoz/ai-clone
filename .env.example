# Postgres + pgvector (docker compose up -d)
DATABASE_URL=postgres://aiclone:aiclone@localhost:5432/aiclone

# Claude API. Bo'sh bo'lsa — MockProvider (oflayn demo, haqiqiy model emas).
ANTHROPIC_API_KEY=

# Embeddinglar: text-embeddings-inference (BGE-M3) manzili. Bo'sh bo'lsa — oflayn HashingEmbedder.
TEI_URL=

# API
PORT=8787
ADMIN_TOKEN=change-me
PUBLIC_BASE_URL=http://localhost:8787

# Telegram bot (BotFather) va u xizmat qiladigan klon
TELEGRAM_BOT_TOKEN=
CLONE_SLUG=dilnoza-demo

# To'lovlar — Payme Business (merchant.paycom.uz): kassa ID va kalit; endpoint: <PUBLIC_BASE_URL>/payments/payme
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST=1
# Fiskal chek (Payme talabi): xizmatning IKPU va qadoq kodi (tasnif.soliq.uz)
PAYME_IKPU_CODE=
PAYME_PACKAGE_CODE=
PAYME_VAT_PERCENT=12
# Click (merchant.click.uz): Prepare/Complete URL — <PUBLIC_BASE_URL>/payments/click/prepare va /complete
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
PAYMENT_RETURN_URL=http://localhost:8787/app

# Ovozli xabarlar (STT): ElevenLabs Scribe. Bo'sh bo'lsa — bot ovozli xabarga "yozib yuboring" deydi.
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2

# Reranker: text-embeddings-inference + bge-reranker-v2-m3 (/rerank). Bo'sh bo'lsa — RRF tartibi.
TEI_RERANK_URL=
# Claude ulanganda LLM klassifikator va so'rovni qayta yozish yoqiladi; 0 — o'chirish.
SMART_GUARDRAILS=1

# Ko'p klonli Telegram: har bir klon egasi dashboard'dan o'z bot tokenini ulaydi.
# Tokenlar AES-256-GCM bilan shifrlanadi; kalit: openssl rand -base64 32. Webhook: <PUBLIC_BASE_URL>/telegram/<id>
CHANNEL_SECRET_KEY=

# Instagram DM va WhatsApp (Meta ilovasi, developers.facebook.com). Webhook: <PUBLIC_BASE_URL>/meta/webhook
# Tokenlar CHANNEL_SECRET_KEY bilan shifrlanadi. Prod uchun Meta App Review kerak (instagram_business_manage_messages, whatsapp_business_messaging).
META_APP_SECRET=
META_VERIFY_TOKEN=
