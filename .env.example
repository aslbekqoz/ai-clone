# Postgres + pgvector (docker compose up -d)
DATABASE_URL=postgres://aiclone:aiclone@localhost:5432/aiclone

# Claude API. Bo'sh bo'lsa — MockProvider (oflayn demo, haqiqiy model emas).
ANTHROPIC_API_KEY=

# Embeddinglar: text-embeddings-inference (BGE-M3) manzili. Bo'sh bo'lsa — oflayn HashingEmbedder.
TEI_URL=

# API
PORT=8787
ADMIN_TOKEN=change-me
PUBLIC_BASE_URL=http://localhost:8787

# Telegram bot (BotFather) va u xizmat qiladigan klon
TELEGRAM_BOT_TOKEN=
CLONE_SLUG=dilnoza-demo

# To'lovlar — Payme Business (merchant.paycom.uz): kassa ID va kalit; endpoint: <PUBLIC_BASE_URL>/payments/payme
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST=1
# Fiskal chek (Payme talabi): xizmatning IKPU va qadoq kodi (tasnif.soliq.uz)
PAYME_IKPU_CODE=
PAYME_PACKAGE_CODE=
PAYME_VAT_PERCENT=12
# Click (merchant.click.uz): Prepare/Complete URL — <PUBLIC_BASE_URL>/payments/click/prepare va /complete
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
PAYMENT_RETURN_URL=http://localhost:8787/app

# Ovozli xabarlar (STT): ElevenLabs Scribe. Bo'sh bo'lsa — bot ovozli xabarga "yozib yuboring" deydi.
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
