# Prod uchun teskari proksi: platforma domeni va mijozlarning o'z domenlari (white-label).
# Mijoz domeni uchun sertifikat faqat API "ha" desa chiqariladi (tasdiqlangan domen, faol Business tarifi).
{
	on_demand_tls {
		ask http://127.0.0.1:8787/internal/tls-ask
	}
}

api.aiclone.uz {
	@internal path /internal/*
	respond @internal 404
	reverse_proxy 127.0.0.1:8787
}

# Mijozlar CNAME qiladigan manzil (CUSTOM_DOMAIN_TARGET=clones.aiclone.uz) va ularning domenlari.
https:// {
	tls {
		on_demand
	}
	reverse_proxy 127.0.0.1:8787
}
